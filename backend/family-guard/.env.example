# HTTP listener
FTN_FAMILY_GUARD_ADDR=:8095

# Optional production CORS origin. Keep unset for local development only.
FTN_FAMILY_GUARD_ALLOWED_ORIGIN=

# Required for production API authentication.
FTN_FAMILY_GUARD_API_TOKEN=

# PostgreSQL DSN. Keep credentials outside Git.
FTN_FAMILY_GUARD_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ftn_family_guard?sslmode=require
